<M14Screen>:

    ScrollView:

        GridLayout:
            cols: 1
            spacing: 15
            padding: 20

            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "M14 PARTY"
                font_size: "30sp"

                size_hint_y: None
                height: 60

# ---------------- STRIP 1 ----------------

            Label:
                text: "STRIP 1 LAID"

                size_hint_y: None
                height: 40

            Label:
                text: root.strip1

                size_hint_y: None
                height: 60

                canvas.before:
                    Color:
                        rgba:
                            (0,1,0,1) if root.strip1=="GREEN" else \
                            (1,0.5,0,1) if root.strip1=="ORANGE" else \
                            (1,0,0,1)

                    Rectangle:
                        pos: self.pos
                        size: self.size

            BoxLayout:

                size_hint_y: None
                height: 60

                Button:
                    text: "RED"

                    on_release:
                        root.set_status("Strip 1","RED")

                Button:
                    text: "ORANGE"

                    on_release:
                        root.set_status("Strip 1","ORANGE")

                Button:
                    text: "GREEN"

                    on_release:
                        root.set_status("Strip 1","GREEN")

# ---------------- STRIP 2 ----------------

            Label:
                text: "STRIP 2 LAID"

                size_hint_y: None
                height: 40

            Label:
                text: root.strip2

                size_hint_y: None
                height: 60

                canvas.before:
                    Color:
                        rgba:
                            (0,1,0,1) if root.strip2=="GREEN" else \
                            (1,0.5,0,1) if root.strip2=="ORANGE" else \
                            (1,0,0,1)

                    Rectangle:
                        pos: self.pos
                        size: self.size

            BoxLayout:

                size_hint_y: None
                height: 60

                Button:
                    text: "RED"

                    on_release:
                        root.set_status("Strip 2","RED")

                Button:
                    text: "ORANGE"

                    on_release:
                        root.set_status("Strip 2","ORANGE")

                Button:
                    text: "GREEN"

                    on_release:
                        root.set_status("Strip 2","GREEN")

# ---------------- STRIP 3 ----------------

            Label:
                text: "STRIP 3 LAID"

                size_hint_y: None
                height: 40

            Label:
                text: root.strip3

                size_hint_y: None
                height: 60

                canvas.before:
                    Color:
                        rgba:
                            (0,1,0,1) if root.strip3=="GREEN" else \
                            (1,0.5,0,1) if root.strip3=="ORANGE" else \
                            (0.4,0.4,0.4,1) if root.strip3=="NA" else \
                            (1,0,0,1)

                    Rectangle:
                        pos: self.pos
                        size: self.size

            BoxLayout:

                size_hint_y: None
                height: 60

                Button:
                    text: "NA"

                    on_release:
                        root.set_status("Strip 3","NA")

                Button:
                    text: "RED"

                    on_release:
                        root.set_status("Strip 3","RED")

                Button:
                    text: "ORANGE"

                    on_release:
                        root.set_status("Strip 3","ORANGE")

                Button:
                    text: "GREEN"

                    on_release:
                        root.set_status("Strip 3","GREEN")

# ---------------- GRID REF ----------------

            Label:
                text: "GRID REFERENCE"

                size_hint_y: None
                height: 40

            TextInput:
                id: grid_input
                hint_text: "Enter Grid Ref"

                size_hint_y: None
                height: 50

            Button:
                text: "UPDATE GRID"

                size_hint_y: None
                height: 60

                on_release:
                    root.set_grid()

            Label:
                text: "Current Grid : " + root.grid

                size_hint_y: None
                height: 50

# ---------------- SOS ----------------

            Button:
                text: "🚨 SOS"

                size_hint_y: None
                height: 60

                on_release:
                    root.send_sos()

# ---------------- LOGOUT ----------------

            Button:
                text: "LOGOUT"

                size_hint_y: None
                height: 60

                on_release:
                    root.logout()